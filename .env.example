# Required for AI receipt scanning and the AI assistant.
# Without it, scanning falls back to local Tesseract OCR and the assistant returns 503.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

DATABASE_URL=sqlite:///budget_buddy.db
RECEIPT_DIR=receipts
# Comma-separated list, or * for any origin (development only)
CORS_ORIGINS=*
